<section>
  <h2>Latest Posts</h2>
  <ul class="post-list">
    {% for post in collections.posts | reverse %}
      <li>
        <div class="meta">{{ post.date | dateReadable }}</div>
        <a href="{{ post.url }}">{{ post.data.title }}</a>
      </li>
    {% endfor %}
  </ul>
</section>
